     "start": 136.084,
     "end": 137.714
    }
   ]
  },
  {
   "id": "s02-7",
   "text": "用户的回复这类接着上次的事，续上原来的会话；别的事件开新会话。",
   "start": 138.064,
   "end": 143.391,
   "clauses": [
